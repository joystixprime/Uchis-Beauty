{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Uchis Dev Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": ["$vite"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
