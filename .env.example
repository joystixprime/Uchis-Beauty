# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Paystack — get your PUBLIC key from https://dashboard.paystack.com/#/settings/developer
# Use the TEST key (pk_test_...) while testing, LIVE key (pk_live_...) for production
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your-public-key-here
